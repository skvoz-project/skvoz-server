#!/usr/bin/env bash
# GitHub Actions: build, test and export the owning Server image.
set -euo pipefail
[[ $# == 0 && ${CI:-} == true ]] || { echo 'GitHub CI required; use bin/build-local for local builds' >&2; exit 1; }
cd "$(dirname "$0")/.."
revision=${GITHUB_SHA:?}
[[ $revision =~ ^[a-f0-9]{40}$ && $(git rev-parse HEAD) == "$revision" && -z $(git status --porcelain --untracked-files=all) ]] || { echo 'Actual clean owning commit required' >&2; exit 1; }
work=$(mktemp -d "${RUNNER_TEMP:?}/skvoz-server-ci.XXXXXX")
token=$(basename "$work")
container=
cleanup() {
  local code=$?
  trap - EXIT INT TERM HUP
  if [[ -n $container ]]; then docker rm -f "$container" >/dev/null 2>&1 || true; fi
  rm -rf "$work"
  exit "$code"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM HUP
mkdir "$work/context"
git archive HEAD | tar -xf - -C "$work/context"
build() {
  docker build --target "$1" --build-arg "SOURCE_REVISION=$revision" --tag "skvoz-server:ci-$1" "$work/context"
}
run_tests() {
  container=$token-$1
  docker run --rm --init --name "$container" --cap-drop ALL --security-opt no-new-privileges:true \
    "skvoz-server:ci-$1" bundle exec rspec spec
  container=
}
build ruby-tests
run_tests ruby-tests
native_archive=$work/context/artifacts/native
mkdir -p "$native_archive"
container=$token-fetch
docker run --rm --name "$container" --cap-drop ALL --security-opt no-new-privileges:true \
  --user "$(id -u):$(id -g)" \
  --mount "type=bind,src=$PWD/product-native-lock.json,dst=/native-lock.json,readonly" \
  --mount "type=bind,src=$native_archive,dst=/download" \
  --entrypoint ruby skvoz-server:ci-ruby-tests /opt/skvoz/server/bin/fetch-native /native-lock.json \
  /download/skvoz-network-0.7.0-x86_64-unknown-linux-gnu-current-identity.tar.gz
container=
build tests
run_tests tests
build deploy
image_id=$(docker image inspect --format '{{.Id}}' skvoz-server:ci-deploy)
ruby bin/export-image --revision "$revision" "$image_id" "$RUNNER_TEMP/server-image"
