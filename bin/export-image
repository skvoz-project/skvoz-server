#!/usr/bin/env ruby
# frozen_string_literal: true
require 'fileutils'
require 'open3'
require 'optparse'
require 'tmpdir'
require 'digest'
require 'json'

revision = nil
OptionParser.new { |parser| parser.on('--revision FULL40SHA') { |value| revision = value } }.parse!
abort 'Usage: export-image [--revision FULL40SHA] IMAGE_ID OUTPUT_DIRECTORY' unless ARGV.size == 2
command = lambda do |*argv|
  out, error, status = Open3.capture3('timeout', '--kill-after=5s', '180s', *argv)
  raise IOError, "Image export command failed: #{error[-4000, 4000] || error}" unless status.success?
  out
end
created = false
begin
  root = File.expand_path('..', __dir__)
  image_id, output = ARGV
  raise ArgumentError, 'Exact Docker image ID required' unless image_id.match?(/\Asha256:[0-9a-f]{64}\z/)
  if revision
    raise ArgumentError, 'Invalid source revision' unless revision.match?(/\A[0-9a-f]{40}\z/)
    raise ArgumentError, 'Server source revision mismatch' unless command.call('git', '-C', root, 'rev-parse', 'HEAD').strip == revision
    raise ArgumentError, 'Server source tree is dirty' unless command.call('git', '-C', root, 'status', '--porcelain', '--untracked-files=all').empty?
  end
  builder = ENV['SKVOZ_BUILDKIT_CONTAINER']
  mapped_output = nil
  if builder
    mapped_output = File.realpath(ENV.fetch('SKVOZ_BUILD_OUTPUT'))
    builder_row = JSON.parse(command.call('docker', 'container', 'inspect', builder)).fetch(0)
    unless builder_row.dig('State', 'Running') && builder_row.dig('Config', 'Image') == 'moby/buildkit@sha256:a82d1ab899cda51aade6fe818d71e4b58c4079e047a0cf29dbb93b2b0465ea69' &&
        builder_row.fetch('Mounts').any? { |mount| mount.values_at('Type', 'Source', 'Destination', 'RW') == ['bind', mapped_output, '/output', true] }
      raise ArgumentError, 'Prepared capped BuildKit output mapping differs'
    end
    builder = builder_row.fetch('Id')
  end
  image = JSON.parse(command.call('docker', 'image', 'inspect', image_id)).fetch(0)
  labels = image.dig('Config', 'Labels') || {}
  unless image['Id'] == image_id && image.values_at('Os', 'Architecture') == %w[linux amd64] &&
      labels.values_at('org.opencontainers.image.source', 'org.opencontainers.image.version', 'org.opencontainers.image.revision') == ['https://github.com/skvoz-project/skvoz-server', '9.0.0', revision || ''] &&
      image.dig('Config', 'Entrypoint') == ['skvoz-server']
    raise ArgumentError, 'Selected image is not the owning Server deploy product'
  end
  output = File.expand_path(output)
  Dir.mkdir(output, 0o700)
  created = true
  Dir.mktmpdir('skvoz-server-image-', mapped_output) do |temporary|
    tar = File.join(temporary, 'image.tar')
    command.call('docker', 'image', 'save', '--output', tar, image_id)
    raise ArgumentError, 'Docker image archive exceeds limit' if File.size(tar) > 1024 * 1024 * 1024
    archive = File.join(temporary, 'image.tar.gz')
    if builder
      mapped = '/output/' + File.basename(temporary)
      command.call('docker', 'exec', builder, '/bin/busybox', 'sh', '-ec',
        'exec /bin/busybox gzip -n -c "$1" > "$2"', 'gzip', mapped + '/image.tar', mapped + '/image.tar.gz')
    else
      command.call('gzip', '-n', tar)
    end
    File.rename(archive, File.join(output, 'server-image.tar.gz'))
  end
  File.write(File.join(output, 'image-id'), image_id + "\n", perm: 0o644)
  sums = %w[image-id server-image.tar.gz].map { |name| "#{Digest::SHA256.file(File.join(output, name)).hexdigest}  #{name}\n" }.join
  File.write(File.join(output, 'SHA256SUMS'), sums, perm: 0o644)
  puts image_id
rescue StandardError => error
  FileUtils.rm_rf(output) if created
  warn "Server image export failed: #{error.class}: #{error.message}"
  exit 1
end
