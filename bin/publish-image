#!/usr/bin/env ruby
# frozen_string_literal: true
require 'open3'
require_relative 'support/server_image'

class ServerImageRelease
  def initialize(root, directory, environment = ENV)
    @root, @directory, @environment = root, directory, environment
  end

  def publish
    unless @environment['GITHUB_REPOSITORY'] == ServerImage::REPOSITORY &&
        %w[push workflow_dispatch].include?(@environment['GITHUB_EVENT_NAME']) && @environment['GITHUB_REF'] == 'refs/heads/main'
      raise ArgumentError, 'Server image publication requires a trusted main run'
    end
    revision = @environment.fetch('GITHUB_SHA')
    raise ArgumentError, 'Invalid source revision' unless revision.match?(/\A[0-9a-f]{40}\z/)
    raise ArgumentError, 'Server source revision mismatch' unless command('git', '-C', @root, 'rev-parse', 'HEAD').strip == revision
    raise ArgumentError, 'Server source tree is dirty' unless command('git', '-C', @root, 'status', '--porcelain', '--untracked-files=all').empty?
    receipt = ServerImage.read(@directory, revision: revision)
    tag = receipt.fetch('tag')
    ["releases/tags/#{tag}", "git/ref/tags/#{tag}"].each do |resource|
      out, error, status = Open3.capture3('timeout', '--kill-after=5s', '60s', 'gh', 'api', '--include', "repos/#{ServerImage::REPOSITORY}/#{resource}")
      raise ArgumentError, "Release/tag absence is unproven: #{error.strip}" unless status.exitstatus == 1 && out.match?(/\AHTTP\/\S+ 404\b/)
    end
    command('gh', 'api', '--method', 'POST', "repos/#{ServerImage::REPOSITORY}/git/refs", '-f', "ref=refs/tags/#{tag}", '-f', "sha=#{revision}")
    command('gh', 'release', 'create', tag, '--verify-tag', '--repo', ServerImage::REPOSITORY, '--target', revision,
      '--title', tag, '--latest=false', '--notes', "Server 8.0.1 Linux amd64; source #{revision}; image #{receipt.fetch('image_id')}.",
      *[ServerImage::ASSET, ServerImage::RECEIPT, 'SHA256SUMS'].map { |name| File.join(@directory, name) })
    tag
  end

  private

  def command(*argv)
    out, error, status = Open3.capture3('timeout', '--kill-after=5s', '60s', *argv)
    raise IOError, "Server release command failed: #{error.strip}" unless status.success?
    out
  end
end

if $PROGRAM_NAME == __FILE__
  abort 'Usage: publish-image RELEASE_DIRECTORY' unless ARGV.size == 1
  begin
    puts ServerImageRelease.new(File.expand_path('..', __dir__), File.expand_path(ARGV[0])).publish
  rescue StandardError => error
    warn "Server image publication failed: #{error.class}: #{error.message}"
    exit 1
  end
end
